// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:2-3.12-trixie",
	"workspaceFolder": "/workspaces/vibespin",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"nodeGypDependencies": true,
			"version": "latest",
			"pnpmVersion": "latest",
			"nvmVersion": "latest"
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "bash -lc 'set -euo pipefail; python -m venv --clear --copies .venv; ./.venv/bin/python -m pip install --upgrade pip; ./.venv/bin/python -m pip install -e \".[dev,notebook]\"; mkdir -p \"$HOME/.gemini\"; npm install -g @google/gemini-cli@latest'",
	"postStartCommand": "bash .devcontainer/scripts/check-ssh-agent.sh",
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/workspaces/vibespin/.venv/bin/python",
				"python.terminal.activateEnvironment": true
			},
			"extensions": [
				"ms-python.python",
				"ms-python.debugpy",
				"GitHub.copilot-chat",
				"ms-python.vscode-pylance",
				"ms-toolsai.vscode-jupyter-slideshow",
				"charliermarsh.ruff",
				"ms-toolsai.jupyter-renderers",
				"ms-toolsai.jupyter-keymap",
				"ms-toolsai.vscode-jupyter-cell-tags",
				"ms-toolsai.jupyter",
				"GitHub.vscode-github-actions",
				"ms-python.vscode-python-envs",
				"ms-python.mypy-type-checker",
				"google.gemini-cli-vscode-ide-companion",
				"ms-vscode.live-server"
			]
		}
	}

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
