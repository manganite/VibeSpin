    "y_datas = [median_tau, median_tau_norm]\n",
    "y_p16s = [p16_tau, p16_tau_norm]\n",
    "y_p84s = [p84_tau, p84_tau_norm]\n",
    "\n",
    "for ax_idx, (ax, y_data, y_p16, y_p84, title) in enumerate(zip(axes, y_datas, y_p16s, y_p84s, titles)):\n",
